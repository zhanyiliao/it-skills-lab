<% const hasPracticeReview = typeof practiceReview !== 'undefined' && practiceReview; %>
<%- include('../partials/practice-review-entry') %>
<% if(recent.length) { %>
<section class="surface-card result-history" aria-labelledby="result-history-title">
<div class="section-heading"><h2 id="result-history-title">最近 5 次正式測驗</h2><span class="section-note">選擇一次紀錄查看成績與檢討</span></div>
<nav class="result-history-list" aria-label="選擇測驗紀錄">
<% recent.forEach((attempt,index)=> { %>
<a class="result-history-row <%= record?.id===attempt.id ? 'is-selected' : '' %>" href="/results/latest?record=<%= attempt.id %>" <%= record?.id===attempt.id ? 'aria-current=page' : '' %>>
<span class="history-date"><strong><%= formatDate(attempt.submitted_at) %></strong><small><%= index===0 ? '最新一次' : '正式測驗' %><%= attempt.is_demo ? ' · 示範紀錄' : '' %></small></span>
<span class="history-score"><%= formatScore(attempt.score) %><small>分</small></span>
<span class="history-meta"><span class="history-time"><%= Math.floor(attempt.elapsed_seconds/60) %> 分 <%= attempt.elapsed_seconds%60 %> 秒</span>
<span class="history-action">查看 <%- icon('arrow') %></span></span>
</a><% }); %>
</nav></section>
<% } %>
<% if(!record) { if(hasPracticeReview) { %><p class="form-note">尚無正式測驗紀錄；本次練習可由上方入口回到檢討。</p><% } else { %><div class="empty-state"><span class="icon-tile mint"><%- icon('document') %></span><h2>準備留下你的第一份成績。</h2><p>尚無正式測驗紀錄，請先完成一次模擬測驗。</p><a class="button" href="/exams">開始模擬測驗 <%- icon('arrow') %></a></div>
<% } } else { const scorePercentage=Math.min(100,Math.max(0,record.score)); const elapsed=record.elapsed_seconds; %>
<section class="result-hero" aria-label="測驗成績摘要"><div class="result-score" role="img" aria-label="總分：<%= formatScore(record.score) %> 分，滿分 100.00 分">
<svg class="score-ring" viewBox="0 0 160 160" aria-hidden="true" focusable="false"><circle class="score-ring-track" cx="80" cy="80" r="70"/><% if(scorePercentage>0) { %><circle class="score-ring-fill" cx="80" cy="80" r="70" pathLength="100" stroke-dasharray="<%= scorePercentage %> 100" transform="rotate(-90 80 80)"/><% } %></svg>
<div class="score-value" aria-hidden="true"><strong><%= formatScore(record.score) %></strong><span>分</span></div></div>
<div class="result-details"><h2><%= feedback(record.score) %></h2><p class="result-account"><%= user.username %> · <%= formatDate(record.submitted_at) %><%= record.is_demo ? ' · 示範紀錄' : '' %></p>
<dl class="result-metadata"><div><dt>考生編號</dt><dd><%= identity(user.identity) %></dd></div><div><dt>測驗時長</dt><dd><%= Math.floor(elapsed/60) %> 分 <%= elapsed%60 %> 秒</dd></div></dl>
<p class="field-help">加權分數＝答對題目的星等總和 ÷ 全卷星等總和 × 100。</p><div class="result-footer"><span class="badge"><%= record.score>=60 && elapsed<=5400 ? '本次測驗合格' : '繼續練習，再挑戰一次' %></span><a class="text-link" href="/results/review?record=<%= record.id %>">查看考後檢討 <%- icon('arrow') %></a></div></div></section>
<%- include('radar') %>
<% } %>
