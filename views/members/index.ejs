<%- include('../partials/pagination', {top:true}) %>
<div class="table-card"><table class="data-table member-management-table"><thead><tr><th>用戶</th><th>申請時間</th><th>角色</th><th>設定</th></tr></thead><tbody>
<% for(const member of members) { %><tr><td class="member-identity"><a class="member-cell" href="/account/<%= member.identity %>"><img class="avatar" src="<%= avatar(member) %>" alt=""><span><strong><%= member.username %></strong><small><%= identity(member.identity) %> · <%= lastSeen(member.last_login) %></small></span></a></td><td data-label="申請時間"><%= formatDate(member.reg_time) %></td><td data-label="角色"><span class="badge"><%= roleName(member) %></span></td><td class="member-controls">
<form action="/members/access?change_role=" method="POST" class="inline-form"><input type="hidden" name="_token" value="<%= csrf %>"><input type="hidden" name="identity" value="<%= member.identity %>"><select name="role" aria-label="<%= member.username %> 的角色" <%= member.identity===user.identity ? 'disabled' : '' %>><% ['學生','教師','管理者'].forEach((label,role)=> { %><option value="<%= role %>" <%= member.role===role ? 'selected' : '' %>><%= label %></option><% }); %></select><button type="submit" <%= member.identity===user.identity ? 'disabled' : '' %>>變更身分</button></form>
<details><summary>刪除帳號</summary><p>確認刪除 <%= member.username %>？此動作無法復原。</p><form action="/members/access?delete=" method="POST"><input type="hidden" name="_token" value="<%= csrf %>"><input type="hidden" name="identity" value="<%= member.identity %>"><button type="submit" class="danger-button" <%= member.role!==0 || member.identity===user.identity ? 'disabled' : '' %>>確認刪除</button></form></details></td></tr><% } %>
</tbody></table></div><%- include('../partials/pagination', {top:false}) %>
