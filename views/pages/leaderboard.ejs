<div class="leaderboard-toolbar"><div class="tab-links"><a href="/leaderboard?type=last_score" class="<%= type==='last_score' ? 'is-active' : '' %>">即時排行</a><a href="/leaderboard?type=high_score" class="<%= type==='high_score' ? 'is-active' : '' %>">總排行</a></div><span class="section-note"><%= type==='high_score' ? '依正式測驗最高分排列' : '依前次正式測驗成績排列' %></span></div>
<% if(members.length) { %><div class="podium-grid"><% members.slice(0,3).forEach((member,index)=> { %><a class="podium-card" href="/account/<%= member.identity %>"><span class="podium-place"><%- icon('trophy') %> 第 <%= index+1 %> 名</span><br><img class="avatar" src="<%= avatar(member) %>" alt=""><h3><%= member.username %></h3><span class="score-value"><%= formatScore(member[type]) %><small>分</small></span></a><% }); %></div><% } %>
<div class="table-card"><table class="data-table"><thead><tr><th>排名</th><th>學習夥伴</th><th><%= type==='high_score' ? '最高成績' : '前次成績' %></th></tr></thead><tbody>
<% const listed = members.map((member,index)=>({...member, rank:index+1})); if(rank > 10) listed.push({...me,rank}); for(const member of listed) { %>
<tr class="<%= user?.identity === member.identity ? 'highlight' : '' %>"><td><span class="rank-number"><%= String(member.rank).padStart(2,'0') %></span></td><td><a class="member-cell" href="/account/<%= member.identity %>"><img class="avatar" src="<%= avatar(member) %>" alt=""><span><strong><%= member.username %></strong><small><%= identity(member.identity) %><%= user?.identity === member.identity ? ' · 這是你' : '' %></small></span></a></td><td><span class="score-value"><%= formatScore(member[type]) %><small>分</small></span></td></tr><% } %>
<% if(!members.length) { %><tr><td colspan="3" class="center">目前沒有會員資料。</td></tr><% } %>
</tbody></table></div>
