<% if(pager.last > 1) { %>
<nav <% if(top) { %>id="pagination"<% } %> class="app-pagination" aria-label="分頁">
<% if(pager.page > 1) { %><a class="pagination-direction" href="<%= pager.url(pager.page-1) %>" rel="prev">上一頁</a><% } else { %><span class="pagination-direction" aria-disabled="true">上一頁</span><% } %>
<div class="pagination-pages">
<% pager.numbers.forEach((number,index) => { %>
<% if(index && number - pager.numbers[index-1] > 1) { %><span class="pagination-ellipsis" aria-hidden="true">…</span><% } %>
<% if(number === pager.page) { %><span class="pagination-page is-current" aria-current="page" aria-label="第 <%= number %> 頁，目前頁面"><%= number %></span><% } else { %><a class="pagination-page" href="<%= pager.url(number) %>" aria-label="第 <%= number %> 頁"><%= number %></a><% } %>
<% }); %></div>
<% if(pager.page < pager.last) { %><a class="pagination-direction" href="<%= pager.url(pager.page+1) %>" rel="next">下一頁</a><% } else { %><span class="pagination-direction" aria-disabled="true">下一頁</span><% } %>
</nav><% } %>
